+/*
+ * Built-in laptop/tablet panels are usually named eDP-*, LVDS-* or DSI-*.
+ * When a touch device has no udev/libinput output association and no
+ * <touch mapToOutput> config, prefer that panel over spanning the whole
+ * layout (which mis-maps the digitizer once an external monitor is added).
+ */
+static char *
+builtin_panel_output_name(void)
+{
+	static const char *const prefixes[] = { "eDP", "LVDS", "DSI" };
+	struct output *output;
+
+	wl_list_for_each(output, &server.outputs, link) {
+		const char *name;
+
+		if (!output_is_usable(output) || !output->wlr_output->name) {
+			continue;
+		}
+		name = output->wlr_output->name;
+		for (size_t i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+			size_t len = strlen(prefixes[i]);
+			if (!strncasecmp(name, prefixes[i], len)) {
+				return output->wlr_output->name;
+			}
+		}
+	}
+	return NULL;
+}
+
 static void
 map_touch_to_output(struct seat *seat, struct wlr_input_device *dev)
 {
