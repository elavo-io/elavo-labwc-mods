+static void
+finish_touch_point(struct seat *seat, struct touch_point *touch_point,
+		uint32_t time_msec, bool cancelled)
+{
+	if (touch_point->surface) {
+		if (cancelled) {
+			struct wl_client *client = wl_resource_get_client(
+				touch_point->surface->resource);
+			struct wlr_seat_client *seat_client =
+				wlr_seat_client_for_wl_client(seat->wlr_seat, client);
+			if (seat_client) {
+				wlr_seat_touch_notify_cancel(seat->wlr_seat, seat_client);
+			}
+		} else {
+			wlr_seat_touch_notify_up(seat->wlr_seat, time_msec,
+				touch_point->touch_id);
+		}
+		wl_list_remove(&touch_point->link);
+		zfree(touch_point);
+		/*
+		 * Native-touch path never went through button emulation, so
+		 * end an interactive move/resize (or clear a unused grab)
+		 * when the last finger lifts / is cancelled.
+		 */
+		if (wl_list_empty(&seat->touch_points)) {
+			cursor_finish_button_release(seat, BTN_LEFT);
+		}
+	} else {
+		cursor_emulate_button(seat, BTN_LEFT,
+			WL_POINTER_BUTTON_STATE_RELEASED, time_msec);
+		ssd_update_hovered_button(NULL);
+		wl_list_remove(&touch_point->link);
+		zfree(touch_point);
+	}
+}
