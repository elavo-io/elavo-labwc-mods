+	if (event->state->committed & WLR_OUTPUT_STATE_BUFFER) {
+		output->covered_commit = true;
+	}
+	maybe_send_locked(output->manager);
+}
+
+static void
+handle_output_present(struct wl_listener *listener, void *data)
+{
+	struct wlr_output_event_present *event = data;
+	struct session_lock_output *output = wl_container_of(listener, output, present);
+	if (!output->covered_commit || !event->presented) {
+		return;
+	}
+	output->covered = true;
+	maybe_send_locked(output->manager);
 }
 
