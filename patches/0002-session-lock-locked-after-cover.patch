+static bool
+lock_output_is_covered(struct session_lock_output *output)
+{
+	/* A disabled output shows nothing, so it needs no frame */
+	return output->covered || !output->output->wlr_output->enabled;
+}
+
+/*
+ * The protocol says not to send locked until every output shows the lock
+ * or the blank. Clients such as swayidle's before-sleep let the system
+ * suspend once they see it, and a panel that suspends before the covering
+ * frame reaches it shows the unlocked session again when it wakes.
+ */
+static void
+maybe_send_locked(struct session_lock_manager *manager)
+{
+	if (!manager->lock || manager->sent_locked) {
+		return;
+	}
+	struct session_lock_output *output;
+	wl_list_for_each(output, &manager->lock_outputs, link) {
+		if (!lock_output_is_covered(output)) {
+			return;
+		}
+	}
+	manager->sent_locked = true;
+	wlr_session_lock_v1_send_locked(manager->lock);
+}
